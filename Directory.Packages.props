<Project>
  <!--
    Central Package Management: every version lives here, csproj files only declare <PackageReference Include="..." />.
    Microsoft.* packages that ship with .NET follow the target framework (net10.0 -> 10.0.x).
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Library -->
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />

    <!-- Samples and tests -->
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <PackageVersion Include="Bogus.Tools.Analyzer" Version="35.6.5" />
    <PackageVersion Include="NetDevPack.Security.Jwt" Version="10.0.0" />
    <PackageVersion Include="NetDevPack.Security.Jwt.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="NetDevPack.Security.Jwt.Store.FileSystem" Version="10.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />

    <!--
      Transitive pins: NetDevPack.Security.Jwt 10.0.0 depends on System.Security.Cryptography.Xml/Pkcs 10.0.12,
      which have high severity advisories. Remove after moving to NetDevPack.Security.Jwt 11.
    -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.15" />
  </ItemGroup>
</Project>
